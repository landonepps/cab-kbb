{
  "manifest_version": 2,
  "name": "Cars & Bids KBB Lookup",
  "version": "1.0.0",
  "description": "Adds a Kelley Blue Book valuation lookup button to Cars & Bids listings.",
  "permissions": [
    "storage",
    "https://carsandbids.com/*",
    "https://www.carsandbids.com/*",
    "https://www.kbb.com/*"
  ],
  "background": {
    "scripts": ["scripts/background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://carsandbids.com/*",
        "https://www.carsandbids.com/*"
      ],
      "js": ["scripts/content-script.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Cars & Bids KBB Lookup"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cab-kbb@example.com"
    }
  }
}
